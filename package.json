{
  "name": "napcat-plugin-mcRcon",
  "plugin": "Minecraft RCON 管理",
  "version": "1.0.1",
  "type": "module",
  "main": "index.mjs",
  "description": "通过 QQ 机器人管理 Minecraft 服务器，支持状态查询、RCON 命令执行",
  "author": "jacksixth",
  "license": "GPL-3.0",
  "keywords": [
    "napcat",
    "plugin",
    "minecraft",
    "rcon",
    "qq"
  ],
  "napcat": {
    "tags": [
      "游戏",
      "工具"
    ],
    "minVersion": "4.14.0",
    "homepage": "https://github.com/jacksixth/napcat-plugin-mcRcon"
  },
  "dependencies": {
    "@minescope/mineping": "^1.6.1",
    "napcat-types": "0.0.16",
    "rcon-client": "^4.2.5"
  },
  "devDependencies": {
    "@rollup/plugin-node-resolve": "^15.3.1",
    "@types/express": "^5.0.6",
    "@types/node": "^20.19.33",
    "napcat-plugin-debug-cli": "^1.2.8",
    "typescript": "^5.9.3",
    "vite": "^6.4.1",
    "ws": "^8.19.0"
  },
  "scripts": {
    "build": "vite build",
    "build:webui": "cd src/webui && pnpm install && pnpm run build",
    "dev:webui": "cd src/webui && pnpm run dev",
    "watch": "vite build --watch",
    "dev": "vite build --watch",
    "push": "vite build",
    "deploy": "vite build",
    "typecheck": "tsc --noEmit"
  }
}